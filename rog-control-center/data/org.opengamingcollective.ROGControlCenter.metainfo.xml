<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.opengamingcollective.ROGControlCenter</id>
  
  <name>ROG Control Center</name>
  <summary>Manage ASUS laptop performance, power and lighting</summary>
  <icon type="stock">rog-control-center</icon>
  
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  
  <url type="homepage">https://github.com/defvs/asusctl</url>
  <url type="bugtracker">https://github.com/defvs/asusctl/issues</url>
  <url type="faq">https://asus-linux.org/faq/</url>
  <url type="help">https://asus-linux.org/manual/</url>
  <url type="vcs-browser">https://github.com/defvs/asusctl</url>

  <categories>
    <category>System</category>
    <category>Settings</category>
  </categories>

  <screenshots>
    <screenshot type="default">
      <caption>Overview in the native GNOME interface (sample data).</caption>
      <image type="source" width="1060" height="900">https://raw.githubusercontent.com/defvs/asusctl/gnome-ui/rog-control-center/gnome/screenshots/overview-light.png</image>
    </screenshot>
    <screenshot>
      <caption>Performance profiles and fan curves (sample data).</caption>
      <image type="source" width="1060" height="900">https://raw.githubusercontent.com/defvs/asusctl/gnome-ui/rog-control-center/gnome/screenshots/performance-dark.png</image>
    </screenshot>
  </screenshots>

  <description>
    <p>ROG Control Center manages ASUS laptop performance profiles, fan curves,
    charge limits, lighting and firmware settings through asusd. The native
    GTK4 and libadwaita interface follows your desktop appearance and adapts
    to narrow windows.</p>
  </description>

  <keywords>
    <keyword>ASUS</keyword>
    <keyword>ROG</keyword>
    <keyword>asusctl</keyword>
    <keyword>Control Center</keyword>
    <keyword>Armoury Crate</keyword>
  </keywords>

  <launchable type="desktop-id">org.opengamingcollective.ROGControlCenter.desktop</launchable>
</component>
